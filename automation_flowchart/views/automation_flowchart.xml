<odoo>

    <record model="ir.ui.view" id="automation_flowchart_form_view">
        <field name="model">automation.flowchart</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_flowchart"
                        string="Open FlowChart"
                        type="object"
                        class="btn"
                    />
                </header>
                <sheet>
                    <h1>
                        <field name="name" nolabel="1" />
                    </h1>
                    <separator />
                    <group>
                        <field name="automation_configuration_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record model="ir.ui.view" id="automation_flowchart_tree_view">
        <field name="model">automation.flowchart</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="automation_configuration_id" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="automation_flowchart_act_window">
        <field name="name">Automation Flowchart</field>
        <field name="res_model">automation.flowchart</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="automation_flowchart_menu">
        <field name="name">Flowcharts</field>
        <field name="parent_id" ref="automation_oca.automation_config_root_menu" />
        <field name="action" ref="automation_flowchart_act_window" />
        <field name="sequence" eval="50" />
    </record>

</odoo>
